# Dependencies (reinstallable via npm install)
node_modules/

# Render outputs (regenerable via tools/render.js)
episodes/*/render/

# Generated audio (regenerable via generate-voice-* tools)
episodes/*/audio/

# Generated subtitle/timing artifacts (regenerable via compute-timing.js / build-subtitles.js)
episodes/*/subtitles.srt
episodes/*/timing.json

# Secrets
api.txt
*.key
.env

# Optional local Node 24+ pin (full path to node.exe)
.node-path


# OS / editor noise
Thumbs.db
.DS_Store
